<style>
@import url('https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&display=swap');
body { margin: 0; padding: 0; overflow: hidden; background: white; }
</style>
<div lang="pt-BR" style="background-color: white; width: 800px; height: 480px; padding: 8px 24px 8px; box-sizing: border-box; overflow: hidden; font-family: 'Atkinson Hyperlegible', sans-serif; color: black; display: flex; flex-direction: column;">

  <!-- Columns -->
  <div style="display: flex; gap: 0; flex: 1; overflow: hidden; min-height: 0;">
    {% for channel in news %}
    
    <!-- Calc Dynamic Font Size based on text length -->
    {% assign total_chars = 0 %}
    {% for item in channel.items limit: 4 %}
      {% assign title_size = item.title | size %}
      {% assign total_chars = total_chars | plus: title_size %}
    {% endfor %}

    {% if total_chars > 340 %}
      {% assign dynamic_font = "18px" %}
    {% elsif total_chars > 260 %}
      {% assign dynamic_font = "20px" %}
    {% elsif total_chars > 180 %}
      {% assign dynamic_font = "22px" %}
    {% else %}
      {% assign dynamic_font = "24px" %}
    {% endif %}

    <div style="flex: 1; display: flex; flex-direction: column; overflow: hidden; min-height: 0; {% unless forloop.first %} border-left: 1px solid #ccc; margin-left: 16px; padding-left: 16px;{% endunless %}">

      <!-- Column header -->
      <div style="font-size: 16px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: #111; margin-bottom: 8px; border-bottom: 2px solid black; padding-bottom: 4px; text-align: center; flex-shrink: 0;">
        {{ channel.name }}
      </div>

      <!-- Items -->
      <div style="display: flex; flex-direction: column; gap: 8px; flex: 1; overflow: hidden; min-height: 0;">
        {% for item in channel.items limit: 4 %}
        <div style="{% unless forloop.last %}padding-bottom: 8px; border-bottom: 1px solid #ccc;{% endunless %}">
          <div style="font-size: {{ dynamic_font }}; font-weight: 700; line-height: 1.15; color: #000; text-align: left; word-spacing: 0px; letter-spacing: 0.5px;">
            {{ item.title }}
          </div>
        </div>
        {% endfor %}
      </div>

    </div>
    {% endfor %}
  </div>

</div>
