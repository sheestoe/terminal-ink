<div style="background-color: white; width: 800px; height: 480px; box-sizing: border-box; overflow: hidden; font-family: sans-serif; color: black; display: flex; flex-direction: column;">
  
  <!-- Header -->
  <div style="padding: 20px 30px; border-bottom: 3px solid black; display: flex; justify-content: space-between; align-items: center;">
    <div style="font-size: 32px; font-weight: bold; letter-spacing: -1px;">PREVISÃO DO TEMPO</div>
    <div style="font-size: 24px; font-weight: bold;">Marília, SP</div>
  </div>

  <!-- Main Content -->
  <div style="display: flex; flex: 1;">
    <!-- Left: Current Weather -->
    <div style="flex: 1; border-right: 3px solid black; padding: 30px; display: flex; flex-direction: column; justify-content: center;">
      <div style="font-size: 140px; font-weight: 800; line-height: 1; letter-spacing: -5px;">
        {{ data.current.temperature_2m | round }}°
      </div>
      <div style="font-size: 36px; font-weight: 600; margin-top: 10px; text-transform: uppercase;">
        {% case data.current.weather_code %}
          {% when 0 %}Céu Limpo
          {% when 1 or 2 or 3 %}Nublado
          {% when 45 or 48 %}Neblina
          {% when 51 or 53 or 55 or 56 or 57 %}Chuvisco
          {% when 61 or 63 or 65 or 66 or 67 %}Chuva
          {% when 71 or 73 or 75 or 77 %}Neve
          {% when 80 or 81 or 82 %}Pancadas de Chuva
          {% when 95 or 96 or 99 %}Tempestade
          {% else %}Indefinido
        {% endcase %}
      </div>
      <div style="margin-top: 30px; font-size: 28px; line-height: 1.5;">
        <div><strong>Sensação:</strong> {{ data.current.apparent_temperature | round }}°C</div>
        <div><strong>Umidade:</strong> {{ data.current.relative_humidity_2m }}%</div>
        <div><strong>Vento:</strong> {{ data.current.wind_speed_10m | round }} km/h</div>
      </div>
    </div>

    <!-- Right: Forecast -->
    <div style="flex: 1; display: flex; flex-direction: column;">
      
      <!-- Today -->
      <div style="flex: 1; border-bottom: 3px solid black; padding: 20px 30px; display: flex; flex-direction: column; justify-content: center;">
        <div style="font-size: 22px; text-transform: uppercase; font-weight: bold; margin-bottom: 10px;">Hoje</div>
        <div style="display: flex; justify-content: space-between; align-items: baseline;">
          <div style="font-size: 48px; font-weight: 800;">{{ data.daily.temperature_2m_max[0] | round }}°</div>
          <div style="font-size: 32px; color: #555;">{{ data.daily.temperature_2m_min[0] | round }}°</div>
        </div>
        <div style="font-size: 20px; margin-top: 5px;">Chuva: {{ data.daily.precipitation_probability_max[0] }}%</div>
      </div>

      <!-- Tomorrow -->
      <div style="flex: 1; border-bottom: 3px solid black; padding: 20px 30px; display: flex; flex-direction: column; justify-content: center;">
        <div style="font-size: 22px; text-transform: uppercase; font-weight: bold; margin-bottom: 10px;">Amanhã</div>
        <div style="display: flex; justify-content: space-between; align-items: baseline;">
          <div style="font-size: 48px; font-weight: 800;">{{ data.daily.temperature_2m_max[1] | round }}°</div>
          <div style="font-size: 32px; color: #555;">{{ data.daily.temperature_2m_min[1] | round }}°</div>
        </div>
        <div style="font-size: 20px; margin-top: 5px;">Chuva: {{ data.daily.precipitation_probability_max[1] }}%</div>
      </div>

      <!-- Day after tomorrow -->
      <div style="flex: 1; padding: 20px 30px; display: flex; flex-direction: column; justify-content: center;">
        <div style="font-size: 22px; text-transform: uppercase; font-weight: bold; margin-bottom: 10px;">Depois de Amanhã</div>
        <div style="display: flex; justify-content: space-between; align-items: baseline;">
          <div style="font-size: 48px; font-weight: 800;">{{ data.daily.temperature_2m_max[2] | round }}°</div>
          <div style="font-size: 32px; color: #555;">{{ data.daily.temperature_2m_min[2] | round }}°</div>
        </div>
        <div style="font-size: 20px; margin-top: 5px;">Chuva: {{ data.daily.precipitation_probability_max[2] }}%</div>
      </div>

    </div>
  </div>
</div>
