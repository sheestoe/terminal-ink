<head>
  <script src="https://unpkg.com/@phosphor-icons/web"></script>
</head>
<div style="background-color: white; width: 800px; height: 480px; padding: 20px; box-sizing: border-box; overflow: hidden; font-family: sans-serif; color: black; display: flex; align-items: center; justify-content: center;">
  
  <div style="width: 760px; height: 440px; border: 6px solid black; border-radius: 30px; display: flex; flex-direction: column; overflow: hidden; box-shadow: 8px 8px 0px black; position: relative;">
    
    {% capture weatherIcon %}
      {% case data.current.weather_code %}
        {% when 0 %}ph-sun
        {% when 1 or 2 %}ph-cloud-sun
        {% when 3 %}ph-cloud
        {% when 45 or 48 %}ph-cloud-fog
        {% when 51 or 53 or 55 or 56 or 57 %}ph-cloud-drizzle
        {% when 61 or 63 or 65 or 66 or 67 %}ph-cloud-rain
        {% when 71 or 73 or 75 or 77 %}ph-cloud-snow
        {% when 80 or 81 or 82 %}ph-cloud-rain
        {% when 85 or 86 %}ph-cloud-snow
        {% when 95 or 96 or 99 %}ph-cloud-lightning
        {% else %}ph-cloud
      {% endcase %}
    {% endcapture %}

    {% assign isAlert = false %}
    {% if data.current.weather_code >= 95 %}
      {% assign isAlert = true %}
    {% endif %}

    <!-- Top Info Section -->
    <div style="flex: 1; display: flex; justify-content: space-between; padding: 30px; border-bottom: 6px solid black;">
      
      <!-- Left side: Icon and Temp -->
      <div style="display: flex; gap: 20px; align-items: center;">
        <i class="ph {{ weatherIcon | strip }}" style="font-size: 140px;"></i>
        <div style="display: flex; flex-direction: column; justify-content: center;">
          <div style="display: flex; align-items: baseline; gap: 5px;">
            <div style="font-size: 110px; font-weight: 900; letter-spacing: -3px; line-height: 1;">{{ data.current.temperature_2m | round }}°</div>
          </div>
          <div style="font-size: 28px; font-weight: 800; text-transform: uppercase;">
            {% case data.current.weather_code %}
              {% when 0 %}Céu Limpo
              {% when 1 or 2 or 3 %}Nublado
              {% when 45 or 48 %}Neblina
              {% when 51 or 53 or 55 or 56 or 57 %}Chuvisco
              {% when 61 or 63 or 65 or 66 or 67 %}Chuva
              {% when 71 or 73 or 75 or 77 %}Neve
              {% when 80 or 81 or 82 %}Pancadas
              {% when 95 or 96 or 99 %}Tempestade
              {% else %}Indefinido
            {% endcase %}
          </div>
        </div>
      </div>

      <!-- Right side: Details -->
      <div style="display: flex; flex-direction: column; align-items: flex-end; text-align: right; justify-content: space-between;">
        <div>
          <div style="font-size: 42px; font-weight: 900; line-height: 1;">Marília</div>
          <div style="font-size: 24px; font-weight: bold;">SP</div>
        </div>
        
        <div style="display: flex; flex-direction: column; gap: 5px; font-size: 20px; font-weight: 600;">
          <div><i class="ph ph-drop"></i> Chuva Hoje: {{ data.daily.precipitation_probability_max[0] }}%</div>
          <div><i class="ph ph-waves"></i> Umidade: {{ data.current.relative_humidity_2m }}%</div>
          <div><i class="ph ph-thermometer"></i> Sensação: {{ data.current.apparent_temperature | round }}°</div>
        </div>
      </div>
      
    </div>

    <!-- Alert Banner (Only shows if thunderstorm) -->
    {% if isAlert %}
    <div style="background-color: black; color: white; text-align: center; font-size: 22px; font-weight: bold; padding: 10px; text-transform: uppercase; letter-spacing: 2px;">
      <i class="ph ph-warning"></i> ALERTA METEOROLÓGICO: TEMPESTADE SEVERA <i class="ph ph-warning"></i>
    </div>
    {% endif %}

    <!-- Bottom Section (Forecast) -->
    <div style="height: 120px; display: flex; background-color: white;">
      
      <div style="flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; border-right: 4px solid black;">
        <div style="font-size: 20px; font-weight: bold; text-transform: uppercase;">Amanhã</div>
        <div style="font-size: 28px; font-weight: 900; margin: 5px 0;">{{ data.daily.temperature_2m_max[1] | round }}° / {{ data.daily.temperature_2m_min[1] | round }}°</div>
        <div style="font-size: 18px; font-weight: 600;"><i class="ph ph-drop"></i> {{ data.daily.precipitation_probability_max[1] }}% de chuva</div>
      </div>

      <div style="flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; border-right: 4px solid black;">
        <div style="font-size: 20px; font-weight: bold; text-transform: uppercase;">Depois</div>
        <div style="font-size: 28px; font-weight: 900; margin: 5px 0;">{{ data.daily.temperature_2m_max[2] | round }}° / {{ data.daily.temperature_2m_min[2] | round }}°</div>
        <div style="font-size: 18px; font-weight: 600;"><i class="ph ph-drop"></i> {{ data.daily.precipitation_probability_max[2] }}% de chuva</div>
      </div>

      <div style="flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; background-color: black; color: white;">
        <div style="font-size: 20px; font-weight: bold; text-transform: uppercase;">Em 3 dias</div>
        <div style="font-size: 28px; font-weight: 900; margin: 5px 0;">{{ data.daily.temperature_2m_max[3] | round }}° / {{ data.daily.temperature_2m_min[3] | round }}°</div>
        <div style="font-size: 18px; font-weight: 600;"><i class="ph ph-drop"></i> {{ data.daily.precipitation_probability_max[3] }}% de chuva</div>
      </div>

    </div>

  </div>
</div>
