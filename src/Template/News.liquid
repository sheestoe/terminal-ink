<div style="background-color: white; width: 800px; height: 480px; padding: 20px; box-sizing: border-box; overflow: hidden; font-family: sans-serif; color: black;">
  <div style="border-bottom: 4px solid black; padding-bottom: 10px; margin-bottom: 15px;">
    <h1 style="margin: 0; font-size: 32px; font-weight: bold;">Notícias (G1 / UOL)</h1>
  </div>
  <div style="display: flex; flex-direction: column; gap: 15px;">
    {% for item in news limit: 4 %}
      <div style="font-size: 24px; line-height: 1.3; font-weight: 500;">
        • {{ item.title }}
      </div>
    {% endfor %}
  </div>
</div>
