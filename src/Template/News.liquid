<div style="background-color: white; width: 800px; height: 480px; box-sizing: border-box; overflow: hidden; font-family: sans-serif; color: black; display: flex; flex-direction: column;">
  
  <!-- Header -->
  <div style="padding: 15px 30px; border-bottom: 4px solid black; display: flex; justify-content: space-between; align-items: center; background: black; color: white;">
    <div style="font-size: 32px; font-weight: 800; letter-spacing: 2px;">NOTÍCIAS</div>
    <div style="font-size: 24px; font-weight: bold; font-style: italic;">G1 Globo</div>
  </div>

  <!-- Main Content -->
  <div style="display: flex; flex-direction: column; flex: 1; padding: 25px;">
    
    <!-- Headline (First News) -->
    <div style="border-bottom: 2px solid black; padding-bottom: 20px; margin-bottom: 20px;">
      <div style="font-size: 16px; font-weight: bold; text-transform: uppercase; margin-bottom: 8px;">Manchete Principal</div>
      <div style="font-size: 42px; font-weight: 800; line-height: 1.1; letter-spacing: -1px;">
        {{ news[0].title }}
      </div>
    </div>

    <!-- Remaining News Grid -->
    <div style="display: flex; gap: 30px; flex: 1;">
      
      <div style="flex: 1; display: flex; flex-direction: column; justify-content: flex-start;">
        <div style="font-size: 14px; font-weight: bold; border-bottom: 1px solid #000; padding-bottom: 5px; margin-bottom: 10px;">Destaque 2</div>
        <div style="font-size: 24px; font-weight: 600; line-height: 1.2;">
          {{ news[1].title }}
        </div>
      </div>

      <div style="flex: 1; display: flex; flex-direction: column; justify-content: flex-start;">
        <div style="font-size: 14px; font-weight: bold; border-bottom: 1px solid #000; padding-bottom: 5px; margin-bottom: 10px;">Destaque 3</div>
        <div style="font-size: 24px; font-weight: 600; line-height: 1.2;">
          {{ news[2].title }}
        </div>
      </div>

      <div style="flex: 1; display: flex; flex-direction: column; justify-content: flex-start;">
        <div style="font-size: 14px; font-weight: bold; border-bottom: 1px solid #000; padding-bottom: 5px; margin-bottom: 10px;">Destaque 4</div>
        <div style="font-size: 24px; font-weight: 600; line-height: 1.2;">
          {{ news[3].title }}
        </div>
      </div>

    </div>

  </div>
</div>
