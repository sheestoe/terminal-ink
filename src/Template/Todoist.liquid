<style>
@import url('https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&display=swap');
body { margin: 0; padding: 0; overflow: hidden; background: white; }
</style>
<div lang="pt-BR" style="background-color: white; width: 800px; height: 480px; padding: 12px 24px; box-sizing: border-box; overflow: hidden; font-family: 'Atkinson Hyperlegible', sans-serif; color: black; display: flex; flex-direction: column;">
  
  <!-- Header -->
  <div style="font-size: 24px; font-weight: 700; text-transform: uppercase; border-bottom: 4px solid black; padding-bottom: 6px; margin-bottom: 12px; display: flex; justify-content: space-between; align-items: flex-end; flex-shrink: 0;">
    <span style="letter-spacing: 1.5px;">Tarefas</span>
    <span style="font-size: 16px; font-weight: 700; color: #666; letter-spacing: 1px;">Todoist</span>
  </div>

  <!-- Dynamic Flex Columns -->
  <div style="display: flex; gap: 32px; flex: 1; align-items: stretch; width: 100%; min-height: 0;">
    {% for project in projects limit: 3 %}
    <div style="flex: 1; display: flex; flex-direction: column; overflow: hidden; min-height: 0; {% unless forloop.first %} border-left: 1px solid #ccc; padding-left: 32px;{% endunless %}">
      
      <!-- Project Title -->
      <div style="font-size: 20px; font-weight: 700; text-transform: uppercase; border-bottom: 2px solid #ccc; padding-bottom: 4px; margin-bottom: 8px; flex-shrink: 0;">
        {{ project.name }}
      </div>

      <!-- Task Items -->
      <div class="items-container" style="display: flex; flex-direction: column; gap: 8px; flex: 1; overflow: hidden; min-height: 0;">
        {% for item in project.tasks limit: 8 %}
        <div style="display: flex; gap: 8px; align-items: flex-start;">
          <div style="font-size: 18px; margin-top: 4px; flex-shrink: 0; color: #666;">•</div>
          <div class="task-title" style="font-weight: 700; line-height: 1.15; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
            {{ item.content }}
          </div>
        </div>
        {% endfor %}
      </div>
      
    </div>
    {% endfor %}
  </div>
</div>

<script>
  const containers = document.querySelectorAll('.items-container');
  containers.forEach(container => {
    let fontSize = 28;
    const titles = container.querySelectorAll('.task-title');
    const setSize = (size) => titles.forEach(t => t.style.fontSize = size + 'px');
    
    setSize(fontSize);
    
    while (container.scrollHeight > container.clientHeight && fontSize > 14) {
      fontSize--;
      setSize(fontSize);
    }
  });
</script>
