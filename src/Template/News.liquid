<div style="background-color: white; width: 800px; height: 480px; padding: 22px 28px 18px; box-sizing: border-box; overflow: hidden; font-family: Georgia, 'Times New Roman', serif; color: black; display: flex; flex-direction: column;">

  <!-- Columns -->
  <div style="display: flex; gap: 0; flex: 1; overflow: hidden;">
    {% for channel in news %}
    <div style="flex: 1; display: flex; flex-direction: column; overflow: hidden;{% unless forloop.first %} border-left: 1px solid #bbb; margin-left: 20px; padding-left: 20px;{% endunless %}">

      <!-- Column header -->
      <div style="font-size: 11px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; font-family: Arial, sans-serif; color: #333; margin-bottom: 12px; border-bottom: 3px double black; padding-bottom: 6px;">
        {{ channel.name }}
      </div>

      <!-- Items -->
      {% for item in channel.items limit: 4 %}
      <div style="margin-bottom: 11px;{% unless forloop.last %} padding-bottom: 11px; border-bottom: 1px solid #e0e0e0;{% endunless %}">
        <div style="font-size: 16px; font-weight: bold; line-height: 1.3; color: #000;">{{ item.title }}</div>
      </div>
      {% endfor %}

    </div>
    {% endfor %}
  </div>

  <!-- Bottom rule -->
  <div style="border-top: 1px solid black; margin-top: 14px; padding-top: 5px; display: flex; justify-content: space-between; align-items: center;">
    <div style="font-size: 9px; font-family: Arial, sans-serif; letter-spacing: 1.5px; text-transform: uppercase; color: #aaa;">
      terminal-ink
    </div>
    <div style="font-size: 9px; font-family: Arial, sans-serif; color: #888;">
      Atualizado: {{ "now" | date: "%d/%m %H:%M" }}
    </div>
  </div>

</div>
