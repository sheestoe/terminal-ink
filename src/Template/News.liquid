<style>
@import url('https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&display=swap');
body { margin: 0; padding: 0; overflow: hidden; background: white; }
</style>
<div lang="pt-BR" style="background-color: white; width: 800px; height: 480px; padding: 8px 24px 8px; box-sizing: border-box; overflow: hidden; font-family: 'Atkinson Hyperlegible', sans-serif; color: black; display: flex; flex-direction: column;">

  <!-- Columns -->
  <div style="display: flex; gap: 0; flex: 1; overflow: hidden; min-height: 0;">
    {% for channel in news %}
    <div style="flex: 1; display: flex; flex-direction: column; overflow: hidden; min-height: 0; {% unless forloop.first %} border-left: 1px solid #ccc; margin-left: 16px; padding-left: 16px;{% endunless %}">

      <!-- Column header -->
      <div style="font-size: 16px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: #111; margin-bottom: 8px; border-bottom: 2px solid black; padding-bottom: 4px; text-align: center; flex-shrink: 0;">
        {{ channel.name }}
      </div>

      <!-- Items -->
      <div class="items-container" style="display: flex; flex-direction: column; gap: 8px; flex: 1; overflow: hidden; min-height: 0;">
        {% for item in channel.items limit: 4 %}
        <div style="{% unless forloop.last %}padding-bottom: 8px; border-bottom: 1px solid #ccc;{% endunless %}">
          <div class="news-title" style="font-weight: 700; line-height: 1.15; color: #000; text-align: left; word-spacing: 0px; letter-spacing: 0.5px;">
            {{ item.title }}
          </div>
        </div>
        {% endfor %}
      </div>

    </div>
    {% endfor %}
  </div>

</div>

<!-- JavaScript Auto-Fitter for perfectly dynamic fonts -->
<script>
  const containers = document.querySelectorAll('.items-container');
  const numColumns = containers.length;
  
  // Decide the starting max font size based on how much width we have
  let startFontSize = 30; // default for 3+ columns
  if (numColumns === 1) {
    startFontSize = 46; // massive font if only 1 feed taking the whole screen
  } else if (numColumns === 2) {
    startFontSize = 36; // very large font for 2 feeds
  }

  containers.forEach(container => {
    let fontSize = startFontSize;
    const titles = container.querySelectorAll('.news-title');
    const setSize = (size) => titles.forEach(t => t.style.fontSize = size + 'px');
    
    setSize(fontSize);
    
    // Loop: if the content overflows the container height, shrink the font 1px at a time
    while (container.scrollHeight > container.clientHeight && fontSize > 14) {
      fontSize--;
      setSize(fontSize);
    }
  });
</script>
