<head>
  <script src="https://unpkg.com/@phosphor-icons/web"></script>
</head>
<div style="background-color: white; width: 800px; height: 480px; padding: 20px; box-sizing: border-box; overflow: hidden; font-family: sans-serif; color: black; display: flex; flex-direction: column;">
  
  <!-- Header -->
  <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 5px solid black; padding-bottom: 10px; margin-bottom: 15px;">
    <div style="font-size: 36px; font-weight: 900; letter-spacing: 1px; text-transform: uppercase;">
      <i class="ph ph-check-square-offset" style="margin-right: 10px;"></i>TAREFAS
    </div>
    <div style="font-size: 20px; font-weight: bold; padding: 5px 15px; background: black; color: white; border-radius: 15px;">
      Todoist
    </div>
  </div>

  <!-- Masonry Columns (Projects) -->
  <div style="column-count: 3; column-gap: 20px; flex: 1; width: 100%;">
    
    {% for project in projects limit: 6 %}
    <div style="break-inside: avoid; display: inline-block; width: 100%; margin-bottom: 20px; background-color: #f8f8f8; border: 4px solid black; border-radius: 20px; padding: 10px; box-shadow: 6px 6px 0px black; box-sizing: border-box;">
      
      <!-- Project Title -->
      <div style="font-size: 20px; font-weight: 900; text-transform: uppercase; border-bottom: 3px solid black; padding-bottom: 5px; margin-bottom: 10px; text-align: center;">
        {{ project.name }}
      </div>

      <!-- Task Items -->
      <div style="display: flex; flex-direction: column; gap: 8px;">
        {% assign task_count = project.tasks | size %}
        {% if task_count > 6 %}
          {% assign font_size = "14px" %}
          {% assign icon_size = "16px" %}
          {% assign pad = "6px" %}
        {% else %}
          {% assign font_size = "17px" %}
          {% assign icon_size = "18px" %}
          {% assign pad = "8px" %}
        {% endif %}

        {% for item in project.tasks limit: 12 %}
        <div style="display: flex; gap: 8px; align-items: flex-start; background: white; padding: {{ pad }}; border: 2px solid black; border-radius: 10px;">
          <div style="font-size: {{ icon_size }}; margin-top: 2px;"><i class="ph ph-circle"></i></div>
          <div style="font-size: {{ font_size }}; font-weight: 700; line-height: 1.1; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
            {{ item.content }}
          </div>
        </div>
        {% endfor %}
      </div>
      
    </div>
    {% endfor %}

  </div>
</div>
