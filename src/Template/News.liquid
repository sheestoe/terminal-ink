<style>
@import url('https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&display=swap');
body { margin: 0; padding: 0; overflow: hidden; background: white; }
</style>
<div lang="pt-BR" style="background-color: white; width: 800px; height: 488px; padding: 4px 20px 10px; margin-top: -8px; box-sizing: border-box; overflow: hidden; font-family: 'Atkinson Hyperlegible', sans-serif; color: black; display: flex; flex-direction: column;">

  <!-- Columns -->
  <div style="display: flex; gap: 0; flex: 1; overflow: hidden; min-height: 0;">
    {% for channel in news %}
    <div style="flex: 1; display: flex; flex-direction: column; overflow: hidden; min-height: 0; {% unless forloop.first %} border-left: 1px solid #ccc; margin-left: 16px; padding-left: 16px;{% endunless %}">

      <!-- Column header -->
      <div style="font-size: 16px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: #111; margin-bottom: 6px; border-bottom: 2px solid black; padding-bottom: 4px; text-align: center; flex-shrink: 0;">
        {{ channel.name }}
      </div>

      <!-- Items -->
      <div style="display: flex; flex-direction: column; gap: 6px; flex: 1; overflow: hidden; min-height: 0;">
        {% for item in channel.items limit: 4 %}
        <div style="{% unless forloop.last %}padding-bottom: 6px; border-bottom: 1px solid #ccc;{% endunless %}">
          <div style="font-size: 20px; font-weight: 700; line-height: 1.2; color: #000; text-align: left; word-spacing: 0px; letter-spacing: 0.5px;">
            {{ item.title }}
          </div>
        </div>
        {% endfor %}
      </div>

    </div>
    {% endfor %}
  </div>

  <!-- Bottom rule -->
  <div style="border-top: 2px solid black; margin-top: auto; padding-top: 4px; padding-bottom: 0px; display: flex; justify-content: space-between; align-items: center; flex-shrink: 0;">
    <div style="font-size: 13px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: black;">
      terminal-ink
    </div>
    <div style="font-size: 13px; font-weight: 700; color: black; text-transform: uppercase;">
      ATUALIZADO: {{ "now" | date: "%d/%m %H:%M" }}
    </div>
  </div>

</div>
