<div lang="pt-BR" style="background-color: white; width: 800px; height: 480px; padding: 22px 28px 18px; box-sizing: border-box; overflow: hidden; font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: black; display: flex; flex-direction: column;">

  <!-- Columns -->
  <div style="display: flex; gap: 0; flex: 1; overflow: hidden;">
    {% for channel in news %}
    <div style="flex: 1; display: flex; flex-direction: column; overflow: hidden;{% unless forloop.first %} border-left: 1px solid #bbb; margin-left: 20px; padding-left: 20px;{% endunless %}">

      <!-- Column header -->
      <div style="font-size: 11px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: #333; margin-bottom: 12px; border-bottom: 3px double black; padding-bottom: 6px;">
        {{ channel.name }}
      </div>

      <!-- Items -->
      <div style="display: flex; flex-direction: column; gap: 14px; flex: 1;">
        {% for item in channel.items limit: 4 %}
        <div style="{% unless forloop.last %}padding-bottom: 14px; border-bottom: 1px solid #e0e0e0;{% endunless %}">
          <div style="font-size: 19px; font-weight: 600; line-height: 1.4; color: #000; text-align: justify; hyphens: auto; -webkit-hyphens: auto; word-spacing: -1px;">
            {{ item.title }}
          </div>
        </div>
        {% endfor %}
      </div>

    </div>
    {% endfor %}
  </div>

  <!-- Bottom rule -->
  <div style="border-top: 1px solid black; margin-top: 14px; padding-top: 5px; display: flex; justify-content: space-between; align-items: center;">
    <div style="font-size: 9px; letter-spacing: 1.5px; text-transform: uppercase; color: #aaa;">
      terminal-ink
    </div>
    <div style="font-size: 9px; color: #888; font-weight: 500;">
      Atualizado: {{ "now" | date: "%d/%m %H:%M" }}
    </div>
  </div>

</div>
